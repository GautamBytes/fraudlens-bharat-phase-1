# Generate a unique value; never commit the populated .env file.
FRAUDLENS_HMAC_SECRET=
FRAUDLENS_ALLOWED_HOSTS=localhost,127.0.0.1,api
FRAUDLENS_RETENTION_DAYS=30
# Optional hosted-demo boundary. Generate independently from the HMAC secret.
FRAUDLENS_DEMO_API_KEY=
# Local Better Auth PostgreSQL service. Generate both values; do not commit .env.
FRAUDLENS_AUTH_DB_PASSWORD=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000
