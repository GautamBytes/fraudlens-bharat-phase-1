# Server-only. Configure these in Vercel Project Settings; never prefix them NEXT_PUBLIC_.
FRAUDLENS_API_URL=http://127.0.0.1:8000
FRAUDLENS_DEMO_API_KEY=
# Better Auth server-only configuration. Generate the secret with `openssl rand -base64 32`.
DATABASE_URL=postgresql://fraudlens:replace-me@127.0.0.1:5432/fraudlens_auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000
# Used only by `npm run auth:create-professor`; do not configure these in Vercel.
FRAUDLENS_PROFESSOR_EMAIL=
FRAUDLENS_PROFESSOR_PASSWORD=
FRAUDLENS_PROFESSOR_NAME=Professor Reviewer
